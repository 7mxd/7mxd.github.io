{
  "_comment": "Source of truth for content blocks. Each entry declares which sections can use the block (scope) and what fields it accepts. The site renderer dispatches on type; the admin UI builds its forms from this same file. To add a new block type: add an entry here, write a renderer in js/blocks.js, add CSS in css/sections.css.",

  "description": {
    "scope": ["project"],
    "label": "Description",
    "fields": [
      { "name": "content", "type": "text", "label": "Description", "required": true }
    ]
  },

  "benchmark": {
    "scope": ["project"],
    "label": "Benchmark table",
    "fields": [
      { "name": "caption", "type": "text", "label": "Caption", "required": false },
      { "name": "unit", "type": "string", "label": "Unit (e.g. NMSE)", "required": true },
      { "name": "rows", "type": "list", "label": "Rows", "required": true,
        "fields": [
          { "name": "label", "type": "string", "label": "Label", "required": true },
          { "name": "value", "type": "string", "label": "Value", "required": true },
          { "name": "highlight", "type": "boolean", "label": "This is my result" } ] }
    ]
  },

  "image": {
    "scope": ["project", "experience", "education", "milestone"],
    "label": "Image",
    "fields": [
      { "name": "src", "type": "image", "label": "Image", "required": true },
      { "name": "srcSmall", "type": "image", "label": "Image (small)", "required": false },
      { "name": "alt", "type": "string", "label": "Alt text", "required": true },
      { "name": "caption", "type": "string", "label": "Caption (optional)", "required": false },
      { "name": "width", "type": "number", "label": "Intrinsic width, px", "required": true },
      { "name": "height", "type": "number", "label": "Intrinsic height, px", "required": true },
      { "name": "widthSmall", "type": "number", "label": "Small width, px", "required": false }
    ]
  },

  "code": {
    "scope": ["project"],
    "label": "Code snippet",
    "fields": [
      { "name": "content", "type": "code", "label": "Code", "required": true }
    ]
  },

  "callout": {
    "scope": ["project"],
    "label": "Callout",
    "fields": [
      { "name": "tone", "type": "select", "label": "Tone", "required": true,
        "options": [
          { "label": "Note", "value": "note" },
          { "label": "Tip", "value": "tip" },
          { "label": "Warning", "value": "warning" } ] },
      { "name": "content", "type": "text", "label": "Content", "required": true }
    ]
  },

  "html": {
    "scope": ["project"],
    "label": "Raw HTML (advanced)",
    "fields": [
      { "name": "content", "type": "code", "label": "Raw HTML", "required": true }
    ]
  },

  "responsibility": {
    "scope": ["experience"],
    "label": "Responsibility / bullet",
    "fields": [
      { "name": "content", "type": "text", "label": "Bullet text", "required": true }
    ]
  },

  "metric": {
    "scope": ["experience", "project"],
    "label": "Metric / number",
    "fields": [
      { "name": "label", "type": "string", "label": "Label", "required": true },
      { "name": "value", "type": "string", "label": "Value", "required": true }
    ]
  },

  "linked-artifact": {
    "scope": ["experience", "project", "education"],
    "label": "Linked artifact (paper, talk, etc.)",
    "fields": [
      { "name": "label", "type": "string", "label": "Label", "required": true },
      { "name": "url", "type": "url", "label": "URL", "required": true }
    ]
  },

  "coursework": {
    "scope": ["education"],
    "label": "Coursework list",
    "fields": [
      { "name": "items", "type": "list", "label": "Courses", "required": true,
        "itemField": { "name": "item", "type": "string", "label": "Course" } }
    ]
  },

  "thesis": {
    "scope": ["education"],
    "label": "Thesis",
    "fields": [
      { "name": "title", "type": "string", "label": "Thesis title", "required": true },
      { "name": "link", "type": "url", "label": "Link (optional)", "required": false }
    ]
  },

  "honor": {
    "scope": ["education", "experience"],
    "label": "Honor / award",
    "fields": [
      { "name": "content", "type": "text", "label": "Content", "required": true }
    ]
  }
}
